  <string name="jossredSettings_welcome">\'জস রেড\' সিস্টেমে স্বাগতম। এই উদ্ভাবনী সিস্টেমটি \'নিউপাইপ\' এবং \'ইউটিউব\' এপিআই উভয়ের একটি শক্তিশালী বিকল্প অফার করে। \'জস রেড\'-এর মাধ্যমে, আপনি সমস্ত ধরণের প্লেব্যাকের সাথে ইন্টারঅ্যাক্ট করার সময় একটি ব্যক্তিগতকৃত অভিজ্ঞতা উপভোগ করতে পারেন, কেবলমাত্র আপনার প্রয়োজন অনুসারে সবচেয়ে উপযুক্ত বিকল্পগুলি সক্রিয় করে৷</string>
  <string name="playSongJR">\'জস রেড\' থেকে সঙ্গীত চালান।</string>
  <string name="playSongJRDesc">এটি আপনাকে উচ্চ মানের সাথে লগ ইন না করেই যেকোনো গান বাজাতে দেয়।</string>
  <string name="gplMessage">এই অ্যাপ্লিকেশনটি GPL 3.0 লাইসেন্সের অধীনে বিতরণ করা হয়েছে এবং ওপেন সোর্স সফ্টওয়্যার ইকোসিস্টেমকে সম্মান করা এবং অবদান রাখা লক্ষ্য করে। আপনি যদি কোনো সম্ভাব্য লঙ্ঘন বা অনিয়ম শনাক্ত করেন, আমরা আপনাকে যথাযথভাবে সমাধান করার জন্য আমাদের সহায়তা দলের সাথে যোগাযোগ করার জন্য আমন্ত্রণ জানাই।</string>
  <string name="aboutScreenText1">"জস রেড" পরিষেবা ব্যবহার করার সময় ছাড়া এই অ্যাপ্লিকেশনটি ব্যবহারকারীর কাছ থেকে ব্যক্তিগত তথ্য সংগ্রহ করে না। প্রদত্ত ডেটা একটি ডাটাবেসে সংরক্ষণ করা হবে যা ব্যবহারকারী যেকোনো সময় ডাউনলোড করতে পারে। উপরন্তু, এই অ্যাপ্লিকেশনটি ইনস্টল করার মাধ্যমে, আপনি "জস রেড" সহ আমাদের পরিষেবাগুলির সাথে সম্পর্কিত পুশ বিজ্ঞপ্তি পেতে পারেন৷ আরো বিস্তারিত জানার জন্য, আমাদের অফিসিয়াল ওয়েবসাইটে উপলব্ধ আমাদের শর্তাবলী দেখুন।</string>
